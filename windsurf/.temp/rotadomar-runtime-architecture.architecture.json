    "cards": [
        {
            "dot": "cyan",
            "title": "Primary Path",
            "items": [
                "Creation or product requests typically flow Browser -> Web UI -> HTTP Entry -> Auth/Access Control -> Domain Modules -> Models/Services -> MySQL.",
                "The diagram centers the server-rendered web app because most repository functionality hangs off web.php route groups and Blade views."
            ]
        },
        {
            "dot": "emerald",
            "title": "Application Shape",
            "items": [
                "This is a Laravel monolith, not a fleet of microservices; modules share the same runtime, database, auth session, and deployment unit.",
                "Core runtime modules include Criacao, Produtos, Movimentacoes, Planejamento de Capacidade, Sugestoes, and Logistica."
            ]
        },
        {
            "dot": "rose",
            "title": "Trust Boundaries",
            "items": [
                "Client devices are untrusted even when they execute first-party Blade and Alpine code.",
                "Authorization is mostly enforced by auth, verified, schedule, admin, and permission middleware, with some resource-specific policy checks."
            ]
        },
        {
            "dot": "amber",
            "title": "Supporting Runtime",
            "items": [
                "Spatie ActivityLog, notifications, and user-specific filters persist back into the same MySQL data plane rather than separate infrastructure.",
                "Files move through the public disk and a dedicated network-file route; PDFs are generated in-process via DomPDF."
            ]
        },
        {
            "dot": "violet",
            "title": "External Integrations",
            "items": [
                "Background sync reaches an external stock API, while admin AI chat fans out to Gemini, Groq, DeepSeek, or OpenAI through Prism fallback logic.",
                "A separate logistics PWA consumes Sanctum-protected API endpoints but still lands in the same Laravel runtime and domain model."
            ]
        }
    ]
}